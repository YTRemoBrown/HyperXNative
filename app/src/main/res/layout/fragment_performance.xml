<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#FF6F06" android:textSize="28sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/version_text" android:textColor="#8A8A8A" android:textSize="12sp" android:gravity="center" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btn_permissions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/permissions_btn" android:backgroundTint="#FF6F06" android:textColor="#000000" android:layout_marginBottom="16dp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_shizuku_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shizuku_status" android:textColor="#FF0000" android:textSize="14sp" android:gravity="center" android:layout_marginBottom="16dp"/>
        
        <!-- سيتم إضافة الأزرار الـ 20 هنا برمجياً أو يدوياً، لتوفير المساحة سنضع زرين كأمثلة -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_performance" android:textColor="#FF6F06" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        
        <!-- زر تجريبي -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#1A1A1A" app:cardCornerRadius="12dp" android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_gallery" app:tint="#FF6F06"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FPS Unlocker" android:textColor="#FFFFFF" android:textStyle="bold"/>
                </LinearLayout>
                <Switch android:id="@+id/switch_fps" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
