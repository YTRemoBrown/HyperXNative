<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permissions_btn"
        android:textColor="#FF6F06"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- بطاقة تعديل النظام -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/modify_settings" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/modify_settings_desc" android:textColor="#8A8A8A" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_marginBottom="8dp"/>
            <Button
                android:id="@+id/btn_write_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_access"
                android:backgroundTint="#FF6F06"
                android:textColor="#000000"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- بطاقة البطارية -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/battery_opt" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/battery_opt_desc" android:textColor="#8A8A8A" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_marginBottom="8dp"/>
            <Button
                android:id="@+id/btn_battery_opt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_access"
                android:backgroundTint="#FF6F06"
                android:textColor="#000000"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- بطاقة الإشعارات -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allow Notifications" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allow the app to send you notifications." android:textColor="#8A8A8A" android:textSize="12sp" android:layout_marginTop="4dp" android:layout_marginBottom="8dp"/>
            <Button
                android:id="@+id/btn_notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/grant_access"
                android:backgroundTint="#FF6F06"
                android:textColor="#000000"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
